---
import { heroContent } from '../data/homepage';
---
<section class="hero section--dark">
  <div class="hero__inner container">
    <div class="hero__content reveal">
      <h1>{heroContent.title}</h1>
      <p>{heroContent.description}</p>
    </div>
    <div class="hero__image reveal">
      <img
        src={heroContent.heroImage}
        alt={heroContent.heroAlt}
        width={800}
        height={592}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(5.5rem, 12vw, 8rem) clamp(5rem, 12vw, 13rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__content {
    max-width: 32rem;
  }

  .hero__content h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .hero__content p {
    font-size: clamp(1rem, 1.5vw, 1.0625rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
  }

  .hero__image img {
    width: 100%;
    max-width: 640px;
    height: auto;
    object-fit: contain;
    margin-inline: auto;
  }

  @media (max-width: 1023px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero__content {
      max-width: 100%;
      order: 1;
    }

    .hero__image {
      order: 2;
    }
  }
</style>
