---
interface Props {
  title: string;
  href: string;
  image: string;
  alt: string;
  variant?: 'default' | 'sidebar';
}

const { title, href, image, alt, variant = 'default' } = Astro.props;
---
<article class:list={['article-card', variant === 'sidebar' && 'article-card--sidebar', 'reveal']}>
  <a href={href} class="article-card__link">
    <div class="article-card__image">
      <img src={image} alt={alt} width={400} height={260} loading="lazy" />
    </div>
    <h3>{title}</h3>
  </a>
</article>

<style>
  .article-card__link {
    display: block;
    transition: transform var(--transition);
  }

  .article-card__link:hover {
    transform: translateY(-3px);
  }

  .article-card__image {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    margin-bottom: 0.75rem;
    background: var(--color-bg-soft);
  }

  .article-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .article-card__link:hover .article-card__image img {
    transform: scale(1.04);
  }

  .article-card h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
    color: var(--color-primary);
  }

  .article-card--sidebar .article-card__image {
    aspect-ratio: 4 / 3;
  }
</style>
