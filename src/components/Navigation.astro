---
import type { NavItem } from '../data/navigation';

interface Props {
  items: NavItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
}
---
<nav class="nav" id="site-nav" aria-label="Menu">
  <ul class="nav__list">
    {items.map((item) => (
      <li class:list={['nav__item', item.children && 'nav-item--has-children']}>
        <a
          href={item.href}
          class:list={['nav-link', isActive(item.href) && 'nav-link--active']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span>{item.label}</span>
          {item.children && (
            <svg class="nav-link__chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </a>
        {item.children && (
          <ul class="nav__submenu">
            {item.children.map((child) => (
              <li>
                <a href={child.href} class="nav__sublink">{child.label}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<style is:global>
  .nav {
    overflow: visible;
  }

  .nav__list {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav-link {
    font-family: var(--font-nav);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--header-link-color, #ffffff);
    padding: 0.375rem 0;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: opacity var(--transition);
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link--active {
    opacity: 0.72;
  }

  .nav-link__chevron {
    margin-top: 1px;
    opacity: 0.9;
    transition: transform var(--transition);
  }

  .nav-item--has-children:hover .nav-link__chevron,
  .nav-item--has-children:focus-within .nav-link__chevron,
  .nav-item--expanded > .nav-link .nav-link__chevron {
    transform: rotate(180deg);
  }

  .nav__submenu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 260px;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
    z-index: 1100;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }

  .nav__submenu::before {
    content: '';
    position: absolute;
    top: -0.75rem;
    left: 0;
    right: 0;
    height: 0.75rem;
  }

  .nav-item--has-children:hover .nav__submenu,
  .nav-item--has-children:focus-within .nav__submenu,
  .nav-item--expanded .nav__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__sublink {
    display: block;
    padding: 0.6rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: #000000;
    transition: background var(--transition), color var(--transition);
  }

  .nav__sublink:hover {
    background: #f5f5f4;
    color: #000000;
  }

  @media (max-width: 1024px) {
    .nav {
      position: fixed;
      inset: 0;
      top: 72px;
      background: #000000;
      padding: 0.75rem 1.25rem 2rem;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      z-index: 1001;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nav.nav--open {
      transform: translateX(0);
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav-link {
      width: 100%;
      justify-content: space-between;
      color: #ffffff;
      padding: 1rem 0;
      font-size: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      opacity: 1;
    }

    .nav-link:hover,
    .nav-link--active {
      opacity: 0.72;
    }

    .nav__submenu {
      position: static;
      opacity: 1;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      transform: none;
      border: none;
      box-shadow: none;
      background: transparent;
      padding: 0;
      min-width: 0;
      transition: max-height 0.3s ease, visibility 0.3s ease;
    }

    .nav__submenu::before {
      display: none;
    }

    .nav-item--expanded .nav__submenu {
      visibility: visible;
      max-height: 520px;
      padding-bottom: 0.5rem;
    }

    .nav__sublink {
      padding: 0.625rem 0 0.625rem 1rem;
      font-size: 0.9375rem;
      color: rgba(255, 255, 255, 0.82);
    }

    .nav__sublink:hover {
      background: transparent;
      color: #ffffff;
    }
  }
</style>
