---
import { dosDontsSection } from '../data/homepage';
---
<section class="cta section section--soft">
  <div class="container cta__grid">
    <div class="cta__image reveal">
      <img
        src={dosDontsSection.image}
        alt={dosDontsSection.imageAlt}
        width={636}
        height={738}
        loading="lazy"
      />
    </div>
    <div class="cta__content reveal">
      <h2>{dosDontsSection.title}</h2>
      <p>{dosDontsSection.description}</p>
      <a href={dosDontsSection.ctaHref} class="btn btn--dark">{dosDontsSection.ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cta__image img {
    width: 100%;
    max-width: 500px;
    height: auto;
    object-fit: contain;
    margin-inline: auto;
  }

  .cta__content h2 {
    margin-bottom: 1rem;
  }

  .cta__content p {
    margin-bottom: 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (max-width: 767px) {
    .cta__grid {
      grid-template-columns: 1fr;
    }

    .cta__image {
      order: 2;
    }

    .cta__content {
      order: 1;
    }
  }
</style>
